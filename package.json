{
  "name": "trainer-hub",
  "version": "1.2.0",
  "description": "Catálogo de jogos e trainers para Windows",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "catalog": "node scripts/catalog.mjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "integrations:pack": "node scripts/integrations.mjs pack"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "local.trainerhub.desktop",
    "productName": "ByteTrainer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/catalog.json",
      "package.json",
      "assets/icon.png",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "resources/solcesto",
        "to": "solcesto"
      },
      {
        "from": "resources/pedro",
        "to": "pedro"
      },
      {
        "from": "resources/desktop",
        "to": "desktop",
        "filter": [
          "WindowProbe.exe"
        ]
      },
      {
        "from": "resources/integrations",
        "to": "integrations",
        "filter": [
          "public-key.pem"
        ]
      },
      {
        "from": "resources/pumpkin",
        "to": "pumpkin"
      },
      {
        "from": "resources/moventure",
        "to": "moventure"
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "differentialPackage": false
    },
    "publish": {
      "provider": "github",
      "owner": "ByteTrainer",
      "repo": "trainer-hub"
    },
    "artifactName": "ByteTrainer-Setup-${version}.${ext}"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
